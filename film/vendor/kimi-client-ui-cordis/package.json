{
  "name": "@moonshot-ai/kimi-client-ui-cordis",
  "description": "Cordis dynamic-plugin definition card: the keyed cordis_define tool row with its run/stop switch",
  "version": "0.1.5-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moonshot-ai/moonshot-harness.git",
    "directory": "packages/extensions/ui-cordis"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "kimi": {
    "client": {
      "inject": [
        "@moonshot-ai/kimi-client-connection",
        "@moonshot-ai/kimi-cordis-client-runner",
        "@moonshot-ai/kimi-api-remotes",
        "@moonshot-ai/kimi-client-locale",
        "@moonshot-ai/kimi-client-ui-input-trigger",
        "@moonshot-ai/kimi-client-ui-renderer",
        "@moonshot-ai/kimi-client-ui-session",
        "@moonshot-ai/kimi-client-ui-tool",
        "@moonshot-ai/kimi-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@moonshot-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "@moonshot-ai/kimi-api-remotes": "^0.1.5-rc.1",
    "@moonshot-ai/kimi-client-connection": "^0.1.5-rc.1",
    "@moonshot-ai/kimi-cordis-client-runner": "^0.1.5-rc.1",
    "@moonshot-ai/kimi-client-locale": "^0.1.5-rc.1",
    "@moonshot-ai/kimi-session": "^0.1.5-rc.1",
    "@moonshot-ai/kimi-client-ui-primitives": "^0.1.5-rc.1",
    "@moonshot-ai/kimi-client-ui-session": "^0.1.5-rc.1",
    "@moonshot-ai/kimi-client-ui-slots": "^0.1.5-rc.1",
    "@moonshot-ai/kimi-client-ui-sidebar": "^0.1.5-rc.1",
    "@moonshot-ai/cordis": "^4.0.2",
    "@moonshot-ai/kimi-client-ui-tool": "^0.1.5-rc.1",
    "@moonshot-ai/kimi-client-ui-input-trigger": "^0.1.5-rc.1",
    "@moonshot-ai/kimi-client-ui-renderer": "^0.1.5-rc.1"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  }
}